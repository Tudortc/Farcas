{
  "name": "@bool/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "better-auth migrate --config ./src/auth.ts --yes"
  },
  "dependencies": {
    "@bool/shared": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/cors": "^10.0.0",
    "better-auth": "^1.6.0",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.0",
    "@better-auth/cli": "^1.4.0",
    "@types/better-sqlite3": "^7.6.0"
  }
}
