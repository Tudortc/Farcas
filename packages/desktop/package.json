{
  "name": "@bool/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "electron ./dist/main.js",
    "build": "tsc -p tsconfig.json && cp src/index.html dist/index.html && cp src/setup.js dist/setup.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "chat.bool.desktop",
    "productName": "bool",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    }
  }
}
