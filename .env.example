# Copy to .env and fill in values

# Required
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3030

# Database path (default: bool.db)
# BOOL_DB=bool.db

# Media storage directory — must be outside the static-served client/dist dir
BOOL_MEDIA_DIR=./media

# Trusted CORS origins (comma-separated)
# BOOL_TRUSTED_ORIGINS=http://localhost:5173

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
# BOOL_VAPID_PUBLIC=
# BOOL_VAPID_PRIVATE=
# BOOL_VAPID_SUBJECT=mailto:admin@example.com
